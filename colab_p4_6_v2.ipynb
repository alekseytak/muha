    "# M\u0423\u0425\u0410 \u2014 P4.6 v2: \u0432\u0440\u0435\u043c\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u0440\u0435\u0434\u0438\u0442\u0430 (Colab)\n",
    "\n",
