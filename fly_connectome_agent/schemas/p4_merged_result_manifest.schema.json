{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muha.local/schemas/p4_merged_result_manifest.schema.json",
  "title": "P4MergedResultManifest",
  "description": "Результат слияния N shard-чанков в единый полный эксперимент. Единственный артефакт, принимаемый scientific gate: partial=false, coverage_verified=true, merge_status=COMPLETE. Без этих констант гейт отвергает CSV как незавершённый.",
  "type": "object",
  "required": [
    "merge_schema_version",
    "protocol_id",
    "manifest_digest",
    "git_sha",
    "merge_status",
    "merge_axis",
    "partial",
    "coverage_verified",
    "shard_count",
    "shard_ids",
    "source_shards",
    "total_cells",
    "expected_cells",
    "arms",
    "seeds",
    "task_streams",
    "episodes_per_seed",
    "merged_csv_path",
    "merged_csv_sha256",
    "merged_at_utc",
    "environment_fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "merge_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-]{2,63}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_status": {
      "type": "string",
      "const": "COMPLETE"
    },
    "merge_axis": {
      "type": "string",
      "enum": ["arms", "seeds"],
      "description": "Ось, по которой были нарезаны shard'ы. Смешанные оси в одном merge запрещены, поэтому у merged-результата ровно одна ось."
    },
    "partial": {
      "type": "boolean",
      "const": false
    },
    "coverage_verified": {
      "type": "boolean",
      "const": true
    },
    "shard_count": {
      "type": "integer",
      "minimum": 2
    },
    "shard_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2,
      "uniqueItems": true
    },
    "source_shards": {
      "type": "array",
      "description": "Заново проверяемое evidence по каждому shard'у: его идентификатор и записанные хеши CSV/provenance/head. merged-gate adapter сверяет их заново с диском, поэтому merged-результат нельзя подделать, пересобрав один лишь манифест.",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["shard_id", "shard_axis", "manifest_digest", "git_sha",
                     "arm_subset", "seed_subset", "task_streams",
                     "csv_sha256", "provenance_jsonl_sha256", "provenance_head_sha256",
                     "shard_manifest_path"],
        "additionalProperties": true,
        "properties": {
          "shard_id": { "type": "string", "minLength": 1 },
          "shard_manifest_path": {
            "type": "string",
            "minLength": 1,
            "description": "Путь к shard_manifest.json этого chunk'а. merged-gate adapter идёт по нему к CSV/provenance/head shard'а и пересчитывает их хеши заново: без указателя на исходник «source shard hash» было бы просто числом в манифесте, которое не с чем сверить."
          },
          "shard_axis": { "type": "string", "enum": ["arms", "seeds"] },
          "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "arm_subset": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "seed_subset": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
          "task_streams": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "csv_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "provenance_jsonl_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "provenance_head_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "total_cells": {
      "type": "integer",
      "minimum": 1
    },
    "expected_cells": {
      "type": "integer",
      "minimum": 1
    },
    "arms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "seeds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 1
    },
    "task_streams": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "episodes_per_seed": {
      "type": "integer",
      "minimum": 1
    },
    "merged_csv_path": {
      "type": "string",
      "minLength": 1
    },
    "merged_csv_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "merged_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "environment_fingerprint": {
      "type": "object",
      "required": ["python", "numpy"],
      "additionalProperties": true,
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "numpy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
